  "item": [
    { "name": "Valid - create user", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nom\":\"Utilisateur Postman\",\"email\":\"postman@email.com\",\"role\":\"ADMIN\",\"actif\":true}" }, "url": "{{baseUrl}}/utilisateurs" } },
    { "name": "Validation error", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nom\":\"\",\"email\":\"invalid\",\"role\":\"ADMIN\",\"actif\":true}" }, "url": "{{baseUrl}}/utilisateurs" } },
    { "name": "404 - unknown user", "request": { "method": "GET", "url": "{{baseUrl}}/utilisateurs/999999" } },
    { "name": "List users", "request": { "method": "GET", "url": "{{baseUrl}}/utilisateurs" } },
    { "name": "Get user", "request": { "method": "GET", "url": "{{baseUrl}}/utilisateurs/{{userId}}" } },
    { "name": "Update user", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nom\":\"Utilisateur modifie\",\"email\":\"user1@email.com\",\"role\":\"ADMIN\",\"actif\":true}" }, "url": "{{baseUrl}}/utilisateurs/{{userId}}" } },
    { "name": "Delete user", "request": { "method": "DELETE", "url": "{{baseUrl}}/utilisateurs/{{userId}}" } }
  ]
